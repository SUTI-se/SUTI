        "events": {
          "type": "array",
          "items": { "$ref": "#/$defs/event" }
        },
        "summaryReports": {
          "type": "array",
          "items": { "$ref": "#/$defs/summaryReport" }
        }
      },
      "required": ["summaryReports"]
    },

